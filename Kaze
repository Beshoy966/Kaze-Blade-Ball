                                        end
                                end,
                                save = function(value, name, data)
                                        if value._pending then
                                                return
                                        end

                                        value._pending = task.delay(0.5, function()
                                                value._pending = nil
                                                value:_write(name, data)
                                        end)
                                end,
                                save_now = function(value, name, data)
                                        if value._pending then
                                                task.cancel(value._pending)
                                                value._pending = nil
                                        end

                                        value:_write(name, data)
                                end,
                                load = function(value, name, default)
                                        local ok, result = pcall(function()
                                                if not isfile("Winds/" .. name .. ".json") then
                                                        return
                                                end

                                                return readfile("Winds/" .. name .. ".json")
                                        end)

                                        if ok and type(result) == "string" and result ~= "" then
                                                local okDecode, decoded = pcall(HttpService.JSONDecode, HttpService, result)

                                                if okDecode and type(decoded) == "table" then
                                                        decoded._flags = decoded._flags or {}
                                                        decoded._keybinds = decoded._keybinds or {}
                                                        decoded._library = decoded._library or {}
                                                        return decoded
                                                end

                                                warn("[Winds config] corrupted config, starting fresh:", name)
                                                pcall(function()
                                                        writefile("Winds/" .. name .. ".json.corrupt", result)
                                                end)
                                        elseif not ok then
                                                warn("failed to load config", result)
                                        end

                                        local fresh = default or { _flags = {}, _keybinds = {}, _library = {} }
                                        value:save_now(name, fresh)
                                        return fresh
                                end,
                        }, Config)

