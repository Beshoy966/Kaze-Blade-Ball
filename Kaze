                        local warpGap = approachDot - toMe:Dot((velUnit - velocity).Unit)
                        local timeToImpact = distance / speed - pingSec
                        local closeRange = 15 - math.min(distance / 1000, 15) + speedBonus

                        if speed > 100 and timeToImpact > pingSec / 10 then
