        Functions.Lol_Is_Curved = function(f)
                if not f then
                        return false
                end
                local zoomies = f:FindFirstChild("zoomies")

                if not zoomies then
                        return false
                end
                local character = localPlayer2.Character
                local rootPart = character and (character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart)

                if not rootPart then
                        return false
                end
                local velocity = zoomies.VectorVelocity
                local speed = velocity.Magnitude

                if speed < 1 then
                        return false
                end
                local ballPos = Functions.Ball_Position(f)

                if not ballPos then
                        return false
                end
                local playerPos = rootPart.Position
                local ping = Functions.Get_Ping_MS()
                local pingSec = ping / 1000
                local ballDirection = velocity.Unit
                local delta = playerPos - ballPos
                local distance = delta.Magnitude

                if distance < 0.001 then
                        return false
                end
                local direction = delta.Unit
                local dot = direction:Dot(ballDirection)
                local reachTime = distance / speed - pingSec
                local lock = Functions.Get_Ball_Lock(f)
                local targeted = f:GetAttribute("target") == localPlayer.Name

                if getgenv().BackWardsAntiCurve ~= false then
                        local earlyBird = math.clamp(pingSec * 0.4, 0, 0.08) + math.clamp((speed - 120) / 2400, 0, 0.07)

                        if dot < -0.65 + earlyBird then
                                return true
                        end
                        local lookahead = math.clamp(pingSec * 2.5 + (distance / speed) * 0.15, math.min(pingSec * 2.5, 0.65), 0.65)
                        local futureDelta = playerPos - (ballPos + velocity * lookahead)
                        local futureDistance = futureDelta.Magnitude
                        local futureDot = futureDistance > 0.001 and (futureDelta * (1 / futureDistance)):Dot(ballDirection) or dot

                        if targeted and dot < -0.45 and futureDot < -0.4 and speed > 8 then
                                return true
                        end
                end

                local previousVelocity = lock.Previous_Velocity

                if not previousVelocity then
                        previousVelocity = {}
                        lock.Previous_Velocity = previousVelocity
                end

                table.insert(previousVelocity, velocity)

                if #previousVelocity > 4 then
                        table.remove(previousVelocity, 1)
                end

                local speedBonus = math.min(speed / 100, 40)
                local closeRange = 15 - math.min(distance / 1000, 15) + 7 * math.max(dot, 0) + speedBonus

                if speed > 160 and reachTime > pingSec / 10 + 0.03 then
                        if speed < 300 then
                                closeRange = math.max(closeRange - 15, 15)
                        elseif speed <= 600 then
                                closeRange = math.max(closeRange - 17, 17)
                        elseif speed <= 1000 then
                                closeRange = math.max(closeRange - 19, 19)
                        else
                                closeRange = math.max(closeRange - 20, 20)
                        end
                end

                if distance < closeRange then
                        return false
                end
                local adjustedReachTime = reachTime + 0.03
                local now2 = tick()

                if speed < 300 then
                        if now2 - lock.Curving < adjustedReachTime / 1.2 then
                                return true
                        end
                elseif speed < 450 then
                        if now2 - lock.Curving < adjustedReachTime / 1.21 then
                                return true
                        end
                elseif speed < 600 then
                        if now2 - lock.Curving < adjustedReachTime / 1.335 then
                                return true
                        end
                else
                        if now2 - lock.Curving < adjustedReachTime / 1.5 then
                                return true
                        end
                end

                local warpThreshold = 0.5 - pingSec
                local directionDifference = ballDirection - velocity

                if directionDifference.Magnitude > 0.001 then
                        local directionSimilarity = direction:Dot(directionDifference.Unit)
                        local warpGap = math.clamp(dot - directionSimilarity, -1, 1)

                        if warpGap < warpThreshold then
                                return true
                        end
                end

                local radians = math.rad(math.asin(math.clamp(dot, -1, 1)))

                lock.Lol_Lerp_Radians = Functions.Lerp(lock.Lol_Lerp_Radians or 0, radians, 0.8)

                if lock.Lol_Lerp_Radians < 0.018 then
                        lock.Lol_Last_Warping = now2
                end

                if now2 - (lock.Lol_Last_Warping or 0) < adjustedReachTime / 1.5 then
                        return true
                end

                if #previousVelocity == 4 then
                        for i = 1, 2 do
                                local previousUnit = previousVelocity [i].Unit
                                local prevDir = ballDirection - previousUnit

                                if prevDir.Magnitude > 0.001 then
                                        local prevDot = direction:Dot(prevDir.Unit)

                                        if dot - prevDot < -pingSec then
                                                return true
                                        end
                                end
                        end
                end

                local backwardsCurveDetected = false
                local horizDirection = Vector3.new(playerPos.X - ballPos.X, 0, playerPos.Z - ballPos.Z)

                if horizDirection.Magnitude > 0 then
                        horizDirection = horizDirection.Unit
                end

                local awayFromPlayer = -horizDirection
                local horizBallDir = Vector3.new(ballDirection.X, 0, ballDirection.Z)

                if horizBallDir.Magnitude > 0 then
                        horizBallDir = horizBallDir.Unit
                        local backwardsAngle = math.deg(math.acos(math.clamp(awayFromPlayer:Dot(horizBallDir), -1, 1)))

                        if backwardsAngle < 60 then
                                backwardsCurveDetected = true
                        end
                end

                return dot < -pingSec or backwardsCurveDetected
        end

