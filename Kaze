                                                        recolor_key(sideEntry.key, sideColor)
                                                end
                                        end

                                        if store then
                                                Library._config._flags["KazeTheme_" .. themeKey] = color_to_hex(color)

                                                if themeKey == "stroke_soft" then
                                                        Library._config._flags["KazeTheme_line"] = color_to_hex(color)
                                                end

                                                queue_theme_save()
                                        end
                                end

