                local function refresh_pill()
                        local currentState = getState()

                        pillLabel.Text = currentState and "ON" or "OFF"
                        pillLabel.TextColor3 = currentState and Color3.fromRGB(120, 255, 170) or Theme.text_mid
                        pillDot.BackgroundColor3 = currentState and Color3.fromRGB(70, 225, 130) or Color3.fromRGB(120, 120, 130)
                        pillStroke.Color = currentState and Color3.fromRGB(46, 110, 74) or Theme.stroke_mid
                        statePill.BackgroundColor3 = currentState and Color3.fromRGB(22, 42, 30) or Theme.chip
                        ring.Color = currentState and Color3.fromRGB(46, 110, 74) or Theme.stroke_mid
                        iconStroke.Color = currentState and Color3.fromRGB(46, 110, 74) or Theme.stroke
                        iconImage.ImageColor3 = currentState and Color3.fromRGB(120, 255, 170) or accent()
                end

                local function apply_toggle()
                        local currentState = getState()

                        setState(not currentState)

                        cardScale.Scale = 0.9
                        TweenService:Create(cardScale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
                        refresh_pill()
                end

                local function save_position()
                        local pos = card.Position

                        if pos and pos.X.Scale == 0 and pos.Y.Scale == 0 then
                                Library._popup_pos [title] = { x = pos.X.Offset, y = pos.Y.Offset }
                        end
                end

                local function close()
                        if closed then
                                return
                        end
                        closed = true

                        save_position()

                        TweenService:Create(card, TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.In), { BackgroundTransparency = 1 }):Play()
                        TweenService:Create(cardScale, TweenInfo.new(0.24, Enum.EasingStyle.Quint, Enum.EasingDirection.In), { Scale = 0.8 }):Play()

                        task.delay(0.26, function()
                                screenGui:Destroy()
                        end)
                end

                closeButton.MouseButton1Click:Connect(function()
                        closeButton.TextColor3 = Theme.text_mid
                        close()
                end)

                local dragging = false
                local moved = false
                local dragStart = nil
                local dragOrigin = nil

                card.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                                dragging = true
                                moved = false
                                dragStart = input.Position
                                dragOrigin = Vector2.new(card.AbsolutePosition.X + card.AbsoluteSize.X * 0.5, card.AbsolutePosition.Y + card.AbsoluteSize.Y * 0.5)
                        end
                end)

                table.insert(connections, UserInputService.InputChanged:Connect(function(input)
                        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                                local delta = input.Position - dragStart

                                if delta.Magnitude > 6 then
                                        moved = true
                                end

                                local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
                                local halfWidth = card.AbsoluteSize.X * 0.5
                                local halfHeight = card.AbsoluteSize.Y * 0.5
                                local x = math.clamp(dragOrigin.X + delta.X, halfWidth + 6, math.max(halfWidth + 7, viewport.X - halfWidth - 6))
                                local y = math.clamp(dragOrigin.Y + delta.Y, halfHeight + 6, math.max(halfHeight + 7, viewport.Y - halfHeight - 6))

                                card.Position = UDim2.new(0, x, 0, y)
                        end
                end))

                table.insert(connections, UserInputService.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                                if dragging then
                                        dragging = false

                                        if not moved then
                                                apply_toggle()
                                        end
                                end
                        end
                end))

                refresh_pill()

                local pillRefreshConnection
                pillRefreshConnection = RunService.Heartbeat:Connect(function()
                        if closed or not screenGui.Parent then
                                pillRefreshConnection:Disconnect()
                                return
                        end

                        refresh_pill()
                end)

                table.insert(connections, pillRefreshConnection)

                screenGui.Destroying:Connect(function()
                        if not closed then
                                save_position()
                        end

                        for _, connection in ipairs(connections) do
                                pcall(function()
                                        connection:Disconnect()
                                end)
                        end
                end)

                TweenService:Create(cardScale, TweenInfo.new(0.34, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
        end)
end


