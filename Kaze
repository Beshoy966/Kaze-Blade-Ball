        rewardsItems = {
                { flag = "Reward_Daily", interval = 5, next = 0, run = rewards_claim_daily },
                { flag = "Reward_Playtime", interval = 5, next = 0, run = rewards_claim_playtime },
                { flag = "Reward_Battlepass", interval = 5, next = 0, run = rewards_claim_battlepass },
                { flag = "Reward_Battlepass_Spins", interval = 12, next = 0, run = function()
                        rewards_spin_battlepass(false)
                end },
                { flag = "Reward_Wheel", interval = 12, next = 0, run = rewards_spin_wheel },
                { flag = "Reward_Gold_Spin", interval = 14, next = 0, run = function()
                        rewards_spin_battlepass(true)
                end },
        }

        local function rewards_step()
                for button, pending in pairs(rewardsPending) do
                        local okCheck, checkPassed = pcall(pending.check)

                        if okCheck and checkPassed then
                                rewardsPending[button] = nil
                                local rewardName = pending.names

                                if type(rewardName) == "function" then
                                        local okName, resolvedName = pcall(rewardName)
                                        rewardName = okName and resolvedName or nil
                                end

                                rewards_notify(rewardName)
                        elseif not button.Parent then
                                rewardsPending[button] = nil
                        end
                end

                for _, item in pairs(rewardsItems) do
                        if Library._config._flags[item.flag] == true and os.clock() >= item.next then
                                item.next = os.clock() + item.interval

                                if not pcall(item.run) then
                                        item.next = os.clock() + 30
                                end
                        end
                end
        end

        local function rewards_stop()
                rewardsRunning = false

                if rewardsThread then
                        pcall(function()
                                task.cancel(rewardsThread)
                        end)

                        rewardsThread = nil
                end

                if rewardsRemoteConnection then
                        rewardsRemoteConnection:Disconnect()
                        rewardsRemoteConnection = nil
                end

                table.clear(rewardsPending)
                table.clear(rewardsSpinQueue)
                rewardsSpinId = nil
                rewardsSpinUntil = 0
        end

        local function rewards_start()
                if rewardsRunning then
                        return
                end

                rewardsRunning = true

                task.spawn(function()
                        for _ = 1, 15 do
                                if not rewardsRunning then
                                        return
                                end

                                local okData, dataResult = pcall(function()
                                        return require(ReplicatedStorage.Packages.Replion).Client:WaitReplion("Data")
                                end)

                                if okData and dataResult then
                                        rewardsData = dataResult
                                        return
                                end

                                task.wait(2)
                        end
                end)

                task.spawn(function()
                        local remoteFolder = ReplicatedStorage:WaitForChild("Remote", 15)

                        remoteFolder = remoteFolder and remoteFolder:WaitForChild("RemoteEvent", 15)

                        if not remoteFolder or not rewardsRunning then
                                return
                        end

                        rewardsRemoteConnection = remoteFolder.OnClientEvent:Connect(function(eventName, eventMeta, eventReward)
                                local spinActive = rewardsSpinId ~= nil

                                if spinActive then
                                        spinActive = os.clock() <= rewardsSpinUntil
                                end

                                if spinActive and type(eventReward) == "table" then
                                        if eventName == "GachaSpinStartBottom" then
                                                rewardsSpinQueue.GachaSpinEndBottom = { rewardsSpinId, eventReward.DisplayName or eventReward.ItemName }
                                        elseif eventName == "GachaSpinStartTop" then
                                                rewardsSpinQueue.GachaSpinEndTop = { rewardsSpinId, eventReward.DisplayName or eventReward.ItemName }
                                        end
                                end

                                local queuedSpin = rewardsSpinQueue[eventName]

                                if queuedSpin then
                                        rewardsSpinQueue[eventName] = nil
                                        rewards_notify(queuedSpin[2])
                                end
                        end)
                end)

                rewardsThread = task.spawn(function()
                        while rewardsRunning do
                                rewards_step()
                                task.wait(1)
                        end
                end)

                Library.SendNotification({ title = "Rewards", text = "ON", duration = 2 })
        end

        local rewardsModule = Misc:create_module({
                title = "Rewards",
                flag = "Rewards",
                description = "Auto claim rewards and spins",
                section = "left",
                layout_order = 3,
                callback = function(state)
                        if state then
                                rewards_start()
                                return
                        end

                        rewards_stop()
