                                end

                                local moduleTop = math.max(moduleY + 4, sectionTop + 4)
                                local moduleBottom = math.min(moduleY + moduleHeight - 4, sectionTop + viewportHeight - 4)
                                local trackHeight = moduleBottom - moduleTop

