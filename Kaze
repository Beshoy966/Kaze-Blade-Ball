                        end

                        lock.Spam_Lerp = Functions.Lerp(lock.Spam_Lerp or 0, math.asin(math.clamp(approachDot, -1, 1)), 0.8)

                        local curveWindow = math.clamp(tonumber(getgenv().CurveWindow) or 0.18, 0.1, 0.35)
                        local windowSec = math.max(curveWindow, math.max(timeToImpact, 0) / 1.5)

                        if lock.Spam_Lerp < 0.018 then
                                lock.Spam_Last_Warp = now2
                        end

                        if now2 - (lock.Spam_Last_Warp or 0) < windowSec then
                                return true
                        end

                        if now2 - (lock.Curving or 0) < windowSec then
