                                                local function calibrate_pointer(frame)
                                                        local inset = GuiService:GetGuiInset()
                                                        local location = UserInputService:GetMouseLocation()
                                                        local topLeft = frame.AbsolutePosition
                                                        local bottomRight = topLeft + frame.AbsoluteSize

                                                        for _, offset in ipairs({ Vector2.new(0, 0), inset, -inset }) do
                                                                local point = location + offset

                                                                if point.X >= topLeft.X and point.X <= bottomRight.X and point.Y >= topLeft.Y and point.Y <= bottomRight.Y then
                                                                        pointerOffset = offset

                                                                        return
                                                                end
                                                        end
                                                end

                                                local function update_field()
                                                        local location = UserInputService:GetMouseLocation() + pointerOffset
                                                        local satLevel = math.clamp((location.X - field.AbsolutePosition.X) / field.AbsoluteSize.X, 0, 1)
                                                        local valLevel = math.clamp((location.Y - field.AbsolutePosition.Y) / field.AbsoluteSize.Y, 0, 1)

                                                        set_color(currentHue, satLevel, 1 - valLevel)
                                                end

                                                local function update_hue()
                                                        local location = UserInputService:GetMouseLocation() + pointerOffset
                                                        local hue = math.clamp((location.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 1)

                                                        set_color(hue, currentSaturation, currentValue)
