                                        end

                                        local valueMap = {}

                                        for _, bindKey in ipairs(BIND_KEYS) do
                                                valueMap[color_key(get_theme_color(bindKey))] = bindKey
                                        end

                                        boundBuckets = {}
                                        boundGradients = {}

                                        for _, inst in ipairs(window._ui:GetDescendants()) do
                                                if not is_guarded(inst) then
                                                        if inst:IsA("GuiObject") then
                                                                bucket_add(valueMap[color_key(inst.BackgroundColor3)], inst, "BackgroundColor3")

                                                                if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
                                                                        bucket_add(valueMap[color_key(inst.TextColor3)], inst, "TextColor3")
                                                                end

                                                                if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
                                                                        bucket_add(valueMap[color_key(inst.ImageColor3)], inst, "ImageColor3")
                                                                end
                                                        elseif inst:IsA("UIStroke") then
                                                                bucket_add(valueMap[color_key(inst.Color)], inst, "Color")
                                                        elseif inst:IsA("UIGradient") then
                                                                local gradientKeys = nil

                                                                for index, keypoint in ipairs(inst.Color.Keypoints) do
                                                                        local pointKey = valueMap[color_key(keypoint.Value)]

                                                                        if pointKey then
                                                                                if not gradientKeys then
                                                                                        gradientKeys = {}
                                                                                end

                                                                                gradientKeys[index] = pointKey
                                                                        end
                                                                end

                                                                if gradientKeys then
                                                                        table.insert(boundGradients, { inst = inst, keys = gradientKeys })
                                                                end
                                                        end
                                                end
                                        end
                                end

