                                        end
                                end

                                table.clear(trackedBalls)
                        end
                end,
        })

        ballTrailModule:create_slider({
                title = "Ball Trail Hue",
                flag = "Ball_Trail_Hue",
                minimum_value = 0,
                maximum_value = 360,
                value = 0,
