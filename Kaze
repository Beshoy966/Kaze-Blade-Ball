                                        end

                                        local folder = Instance.new("Folder")
                                        folder.Name = "Acrylic"
                                        folder.Parent = workspace.CurrentCamera
                                        self._folder = folder
                                end

                                Acrylic.create_depth_of_fields = function()
                                        local acrylicBlur = Lighting:FindFirstChild("AcrylicBlur") or Instance.new("DepthOfFieldEffect")
                                        acrylicBlur.FarIntensity = 0
                                        acrylicBlur.FocusDistance = 0.05
                                        acrylicBlur.InFocusRadius = 0.1
                                        acrylicBlur.NearIntensity = 1
                                        acrylicBlur.Name = "AcrylicBlur"
                                        acrylicBlur.Parent = Lighting

                                        for _, child in Lighting:GetChildren() do
                                                if child:IsA("DepthOfFieldEffect") then
                                                        if child ~= acrylicBlur then
                                                                Connections [child] = child:GetPropertyChangedSignal("FarIntensity"):Connect(function()
                                                                        child.FarIntensity = 0
                                                                end)

                                                                child.FarIntensity = 0
                                                        end
                                                end
                                        end
                                end

                                Acrylic.create_frame = function(self)
                                        local frame = Instance.new("Frame")
                                        frame.Size = UDim2.new(1, 0, 1, 0)
                                        frame.Position = UDim2.new(0.5, 0, 0.5, 0)
                                        frame.AnchorPoint = Vector2.new(0.5, 0.5)
                                        frame.BackgroundTransparency = 1
                                        frame.Parent = self._object
                                        self._frame = frame
                                end

                                Acrylic.create_root = function(self)
                                        local part = Instance.new("Part")
                                        part.Name = "Root"
                                        part.Color = Color3.new(0, 0, 0)
                                        part.Material = Enum.Material.Glass
                                        part.Size = Vector3.new(1, 1, 0)
                                        part.Anchored = true
                                        part.CanCollide = false
                                        part.CanQuery = false
                                        part.Locked = true
                                        part.CastShadow = false
                                        part.Transparency = 0.98
                                        part.Parent = self._folder
                                        local specialMesh = Instance.new("SpecialMesh")
                                        specialMesh.MeshType = Enum.MeshType.Brick
                                        specialMesh.Offset = Vector3.new(0, 0, -0.1)
                                        specialMesh.Parent = part
                                        self._root = part
                                end

                                Acrylic.setup = function(self)
                                        self:create_depth_of_fields()
                                        self:create_folder()
                                        self:create_root()
                                        self:create_frame()
                                        self:render(0.001)
                                        self:check_quality_level()
                                end

                                Acrylic.render = function(self, depth)
                                        local currentCamera = workspace.CurrentCamera
                                        local screenGui = self._object:FindFirstAncestorWhichIsA("ScreenGui")
                                        local vector2 = Vector2.zero
                                        local vector22 = Vector2.zero
                                        local vector23 = Vector2.zero
                                        local needsRender = true

                                        local function shouldRender()
                                                return self._root ~= nil and self._object.Visible and (screenGui == nil or screenGui.Enabled)
                                        end

                                        local function update_root()

                                                local topLeft = Util:viewport_point_to_world(vector2, depth)
                                                local topRight = Util:viewport_point_to_world(vector22, depth)
                                                local bottomRight = Util:viewport_point_to_world(vector23, depth)
                                                local magnitude = (topRight - topLeft).Magnitude
                                                local magnitude2 = (topRight - bottomRight).Magnitude
                                                local cFrame = currentCamera.CFrame
                                                self._root.CFrame = CFrame.fromMatrix((topLeft + bottomRight) / 2, cFrame.XVector, cFrame.YVector, cFrame.ZVector)
                                                self._root.Mesh.Scale = Vector3.new(magnitude, magnitude2, 0)
                                        end

                                        local function update_corners()
                                                local offset = Util:get_offset()
                                                local n = self._frame.AbsoluteSize - Vector2.new(offset, offset)
                                                local topLeft = self._frame.AbsolutePosition + Vector2.new(offset / 2, offset / 2)
                                                vector2 = topLeft
                                                vector22 = topLeft + Vector2.new(n.X, 0)
                                                vector23 = topLeft + n
                                                needsRender = true
                                        end

                                        local function mark_dirty()
                                                needsRender = true
                                        end

                                        Connections.cframe_update = currentCamera:GetPropertyChangedSignal("CFrame"):Connect(mark_dirty)
                                        Connections.viewport_size_update = currentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(mark_dirty)
                                        Connections.field_of_view_update = currentCamera:GetPropertyChangedSignal("FieldOfView"):Connect(mark_dirty)
                                        Connections.frame_absolute_position = self._frame:GetPropertyChangedSignal("AbsolutePosition"):Connect(update_corners)
                                        Connections ["frame_size_update"] = self._frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(update_corners)
                                        Connections.blur_render = RunService.RenderStepped:Connect(function()
                                                if not self._object.Parent then
                                                        Connections:disconnect("blur_render")
                                                        return
                                                end
                                                if shouldRender() then
                                                        if needsRender then
                                                                update_root()
                                                                needsRender = false
                                                        end
                                                end
                                        end)
                                        update_corners()
                                end
                        end
                end

                do
                        Acrylic.check_quality_level = function(self)
                                local gameSettings = UserSettings().GameSettings

                                if gameSettings.SavedQualityLevel.Value < 8 then
                                        self:change_visiblity(false)
                                end

                                Connections.quality_level = gameSettings:GetPropertyChangedSignal("SavedQualityLevel"):Connect(function()
