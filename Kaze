                        if not dragStart then
                                return
                        end

                        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                                local delta = input.Position - dragStart
                                panel.Position = UDim2.new(dragPosition.X.Scale, dragPosition.X.Offset + delta.X, dragPosition.Y.Scale, dragPosition.Y.Offset + delta.Y)
                        end
                end)

                performanceState.gui = screenGui
                performanceState.fpsLabel = fpsLabel
                performanceState.pingLabel = pingLabel
                performanceState.bars = bars
        end

local performanceModule = VisualsTab:create_module({
                title = "Performance",
                flag = "Performance_Overlay",
                description = "Show your FPS and ping",
                section = "left",
                callback = function(state)
                        if not state then
                                if moduleConnections["Performance Overlay"] then
                                        moduleConnections["Performance Overlay"]:Disconnect()
                                        moduleConnections["Performance Overlay"] = nil
                                end

                                perf_destroy()
                                return
                        end

                        perf_create()

                        local frameCount = 0
                        local elapsed = 0
                        local updateElapsed = 0

                        moduleConnections["Performance Overlay"] = RunService.RenderStepped:Connect(function(deltaTime)
                                frameCount = frameCount + 1
                                elapsed = elapsed + deltaTime
                                updateElapsed = updateElapsed + deltaTime

                                if elapsed >= 0.5 then
                                        if performanceState.fpsLabel then
                                                performanceState.fpsLabel.Text = tostring(math.round(frameCount / elapsed))
                                        end

                                        frameCount = 0
                                        elapsed = 0
                                end

                                if updateElapsed >= 0.5 then
                                        updateElapsed = 0
                                        local ping = math.round(localPlayer:GetNetworkPing() * 1000)

                                        if performanceState.pingLabel then
                                                performanceState.pingLabel.Text = ping .. " ms"
                                        end

                                        table.insert(performanceState.samples, ping)

                                        if #performanceState.samples > performanceState.maxSamples then
                                                table.remove(performanceState.samples, 1)
                                        end

                                        if performanceState.bars then
                                                for index, bar in ipairs(performanceState.bars) do
                                                        local sample = performanceState.samples[index] or 0
                                                        bar.Size = UDim2.new(0, 2, 0, math.clamp(3 + sample / 8, 3, 34))
                                                        bar.BackgroundTransparency = sample > 0 and 0.15 or 0.82
                                                end
                                        end
                                end
                        end)
                end,
        })

        performanceModule._size = performanceModule._size + 6
end

