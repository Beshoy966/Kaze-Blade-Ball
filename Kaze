                                        Library._config._flags [config.flag .. "_max"] = self.max_value
                                        Config:save(game.GameId, Library._config)
                                        config.callback(self.min_value, self.max_value)
                                end

                                local function on_input(input)
                                        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
                                                return
                                        end
                                        local position2 = input.Position
                                        local absolutePosition = frame10.AbsolutePosition
                                        local minX = absolutePosition.X + (data.min_value - config.minimum_value) / (config.maximum_value - config.minimum_value) * frame10.AbsoluteSize.X

                                        local maxX = absolutePosition.X + (data.max_value - config.minimum_value) / (config.maximum_value - config.minimum_value) * frame10.AbsoluteSize.X
                                        local distToMin = math.abs(position2.X - minX)
                                        local distToMax = math.abs(position2.X - maxX)

                                        if distToMin < 35 and distToMin < distToMax then
                                                data.active_thumb = "min"
                                                data.is_dragging = true
                                        elseif distToMax < 35 then
                                                data.active_thumb = "max"
                                                data.is_dragging = true
                                        end
                                end

                                local function on_drag_move(input)
                                        if not data.is_dragging or not data.active_thumb then
                                                return
                                        end
                                        local newValue = position_to_value(input.Position.X)

                                        if data.active_thumb == "min" then
                                                data.min_value = math.max(math.min(newValue, data.max_value), config.minimum_value)
                                        elseif data.active_thumb == "max" then
                                                local maximumValue = config.maximum_value
                                                data.max_value = math.min(math.max(newValue, data.min_value), maximumValue)
                                        end

                                        data:update_positions(false)
                                end

                                local function on_input_end(input)
                                        if not (input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch) then
                                                if data.is_dragging then
                                                        data:update_positions(true)
                                                end

                                                data.is_dragging = false
                                                data.active_thumb = nil
                                                return
                                        end

                                        return

                                end

                                textButton3.InputBegan:Connect(function(input)
                                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                                                on_input(input)
                                        end
                                end)

                                textButton3.InputChanged:Connect(function(input)
                                        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                                                if data.is_dragging then
                                                        on_drag_move(input)
                                                end
                                        end

                                end)

                                textButton3.InputEnded:Connect(function(input)
                                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                                                on_input_end(input)

                                        end
                                end)

                                Connections ["range_slider_touch_" .. config.flag] = UserInputService.TouchMoved:Connect(function(self, finished)
                                        if finished then
                                                return
                                        end

                                        if data.is_dragging then
                                                on_drag_move(self)
                                        end
                                end)

                                if Library:flag_type(config.flag .. "_min", "number") then
                                        data.min_value = Library._config._flags [config.flag .. "_min"]
                                        data.max_value = Library._config._flags [config.flag .. "_max"] or config.max_value
                                end

                                task.spawn(function()
                                        task.wait()
                                        data:update_positions(true)
                                end)

                                return data
                        end

