Library.show_score = function(name, label)
        local container = Library._score_container

        if not container or not container.Parent or Library._scores [name] then
                return
        end

        label = label or name
        local textBoundsParams = Instance.new("GetTextBoundsParams")
        textBoundsParams.Text = label
        textBoundsParams.Font = Font.new(FONT, Enum.FontWeight.Medium)
        textBoundsParams.Size = 10
        textBoundsParams.Width = 10000
        local labelWidth = TextService:GetTextBoundsAsync(textBoundsParams).X
        local chipWidth = math.clamp(labelWidth + 58, 86, 190)
        local holder = Instance.new("Frame")
        holder.Size = UDim2.new(1, 0, 0, 28)
        holder.BackgroundTransparency = 1
        holder.Name = name
        holder.Parent = container
        local chip = Instance.new("Frame")
        chip.Size = UDim2.new(0, chipWidth, 1, 0)
        chip.AnchorPoint = Vector2.new(1, 0)
        chip.Position = UDim2.new(1, 0, 0, 0)
        chip.BackgroundColor3 = Color3.fromRGB(17, 17, 17)
        chip.BackgroundTransparency = 0.06
        chip.BorderSizePixel = 0
        chip.Parent = holder
        add_corner(chip, 14)
        add_stroke(chip, Color3.fromRGB(48, 48, 48), 0.25)
        local scoreDot = Instance.new("Frame")
        scoreDot.Size = UDim2.new(0, 5, 0, 5)
        scoreDot.Position = UDim2.new(0, 11, 0.5, 0)
        scoreDot.AnchorPoint = Vector2.new(0, 0.5)
        scoreDot.BackgroundColor3 = accent()
        scoreDot.BorderSizePixel = 0
        scoreDot.Parent = chip
        add_corner(scoreDot, 8)
        local scoreName = Instance.new("TextLabel")
        scoreName.BackgroundTransparency = 1
        scoreName.Size = UDim2.new(1, -52, 1, 0)
        scoreName.Position = UDim2.new(0, 22, 0, 0)
        scoreName.FontFace = Font.new(FONT, Enum.FontWeight.Medium)
        scoreName.TextSize = 10
        scoreName.TextColor3 = Color3.fromRGB(200, 200, 200)
        scoreName.TextXAlignment = Enum.TextXAlignment.Left
        scoreName.Text = label
        scoreName.Parent = chip
        local scoreCount = Instance.new("TextLabel")
        scoreCount.BackgroundTransparency = 1
        scoreCount.Size = UDim2.new(0, 32, 1, 0)
        scoreCount.Position = UDim2.new(1, -10, 0, 0)
        scoreCount.AnchorPoint = Vector2.new(1, 0)
        scoreCount.FontFace = Font.new(FONT, Enum.FontWeight.Bold)
        scoreCount.TextSize = 11
        scoreCount.TextColor3 = Theme.text
        scoreCount.TextXAlignment = Enum.TextXAlignment.Right
        scoreCount.Text = "0"
        scoreCount.Parent = chip
        chip.Position = UDim2.new(1.5, 0, 0, 0)
        TweenService:Create(chip, TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Position = UDim2.new(1, 0, 0, 0) }):Play()
        Library._scores [name] = { holder = holder, chip = chip, count = 0, countLabel = scoreCount, dot = scoreDot, lastPulse = 0 }
end

Library.bump_score = function(name, amount)
        local score = Library._scores [name]

        if not score then
                return
        end

        score.count = score.count + (amount or 1)
        score.countLabel.Text = tostring(score.count)

        if tick() - score.lastPulse >= 0.18 then
                score.lastPulse = tick()
                score.dot.BackgroundTransparency = 0
                TweenService:Create(score.dot, TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { BackgroundTransparency = 0.35 }):Play()
