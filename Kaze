        local function rewards_spin_battlepass(goldMode)
                local battlepass = rewards_battlepass()

                if not rewards_battlepass_active(battlepass) then
                        return
                end

                if rewards_get({ "InfiniteBattlepass", "UseSteps" }) then
                        return
                end

                if os.clock() < rewardsSpinUntil then
                        return
                end

                local season = tostring(battlepass.Season or "")
                local gachaRounds = rewards_get("InfGachaRounds" .. season) or 0

                if goldMode then
                        local skipSpin = gachaRounds > 0 or (battlepass.SeasonData and battlepass.SeasonData.Currency and battlepass.SeasonData.Currency.Name ~= "Gold")

                        if not skipSpin then
                                skipSpin = rewards_get("CanPurchaseInfGachaRounds" .. season .. "DailyExtra") ~= true
                        end

                        if not skipSpin then
                                skipSpin = (rewards_get({ "InfiniteBattlepass", "Currency" }) or 0) < 400
                        end

                        if skipSpin then
                                return
                        end
                elseif gachaRounds <= 0 then
                        return
                end

                rewardsBattlepassUI = rewardsBattlepassUI or rewards_module({ "Shared", "BattlepassUIType" })

                local isWindow = rewardsBattlepassUI == "Window"
                local spinNode = isWindow and rewards_gui("BattlepassSpinGacha", "Main") or rewards_gui("Battlepass", "Main", "Background", "Views", "SpinGacha")
                local spinButton = spinNode and spinNode:FindFirstChild("Background") and spinNode.Background:FindFirstChild("Spin") and spinNode.Background.Spin:FindFirstChild("Spin")

                rewardsSpinId = goldMode and "Reward_Gold_Spin" or "Reward_Battlepass_Spins"
                rewardsSpinUntil = os.clock() + 15

                if not rewards_claim(spinButton, rewards_controller("Battlepass", "BattlepassSpinGachaController"), function()
                        local stillActive = goldMode and rewards_get("CanPurchaseInfGachaRounds" .. season .. "DailyExtra") ~= true

                        if not stillActive then
                                stillActive = not goldMode

                                if stillActive then
                                        stillActive = (rewards_get("InfGachaRounds" .. season) or 0) < gachaRounds
                                end
                        end

                        return stillActive
                end) then
                        rewardsSpinId = nil
                        rewardsSpinUntil = 0
                end
