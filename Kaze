        local ReplicatedStorage = game:GetService("ReplicatedStorage")

        local exploitStates = {
                ["Thunder Dash"] = { name = "Thunder Dash", module = nil, originalCooldown = nil, originalReduction = nil, loop = nil },
                ["Super Jump"] = { name = "Super Jump", module = nil, originalCooldown = nil, originalReduction = nil, loop = nil },
                ["Dash"] = { name = "Dash", module = nil, originalCooldown = nil, originalReduction = nil, loop = nil },
        }

        local function ensure_ability(state)
                if state.module then
                        return true
                end

                local shared = ReplicatedStorage:FindFirstChild("Shared")
                local abilities = shared and shared:FindFirstChild("Abilities")
                local abilityModule = abilities and abilities:FindFirstChild(state.name)

                if not abilityModule then
                        return false
                end

                local ok, result = pcall(require, abilityModule)

                if ok and result then
                        state.module = result
                        state.originalCooldown = result.cooldown
                        state.originalReduction = result.cooldownReductionPerUpgrade
                        return true
                end

                return false
        end

        local function apply_ability(state)
                if not ensure_ability(state) then
                        return
                end

                pcall(function()
                        state.module.cooldown = 0
                        state.module.cooldownReductionPerUpgrade = 0
                end)
        end

        local function restore_ability(state)
                if not state.module then
                        return
                end

                pcall(function()
                        state.module.cooldown = state.originalCooldown
                        state.module.cooldownReductionPerUpgrade = state.originalReduction
                end)
        end

        local function start_exploit(state)
                if state.loop then
                        return
                end

                apply_ability(state)

                state.loop = task.spawn(function()
                        while state.loop do
                                apply_ability(state)
                                task.wait(0.5)
                        end
                end)
        end

        local function stop_exploit(state)
                state.loop = nil
                restore_ability(state)
        end

