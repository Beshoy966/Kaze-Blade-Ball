end)

do
        local function disconnect_registry(registry)
                if type(registry) ~= "table" then
                        return
                end

                for _, connection in pairs(registry) do
                        if typeof(connection) == "RBXScriptConnection" then
                                pcall(function()
                                        connection:Disconnect()
                                end)
                        end
                end
        end

        _G.Kaze_unload = function()
                pcall(function()
                        System.autoparry.stop()
                end)

                pcall(disconnect_registry, Library._connections)
                pcall(disconnect_registry, gameConnections)
                pcall(disconnect_registry, moduleConnections)
                pcall(function()
                        disconnect_registry(System.__properties.__connections)
                end)

                pcall(function()
                        Config:save_now(game.GameId, Library._config)
                end)

                pcall(function()
                        local existingGui = CoreGui:FindFirstChild("Kaze")
                        if existingGui then
                                existingGui:Destroy()
                        end
                end)

                getgenv()._KazeLoaded = nil
                getgenv()._KazeParryDuration = nil
                getgenv()._KazeSkipNextAnim = nil
                print("[Kaze] Unloaded successfully")
        end
end
