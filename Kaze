do
        local TeleportService = game:GetService("TeleportService")
        local rejoinConnection = nil
        local rejoinTriggered = false

        local function rejoin_server()
                Library.SendNotification({ title = "Server Tools", text = "Rejoining server...", duration = 2 })
                TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, localPlayer)
        end

        local function hop_server()
                Library.SendNotification({ title = "Server Tools", text = "Hopping to a new server...", duration = 2 })

                task.spawn(function()
                        local placeId = game.PlaceId
                        local currentJobId = game.JobId
                        local success, result = pcall(function()
                                return HttpService:JSONDecode(HttpService:GetAsync("https://games.roblox.com/v1/games/" .. placeId .. "/servers/0?sortOrder=Asc&limit=100", true))
                        end)

                        if success and result and result.data then
                                local availableServers = {}

                                for _, server in ipairs(result.data) do
                                        if server.id ~= currentJobId and server.maxPlayers > server.players then
                                                table.insert(availableServers, server)
                                        end
                                end

                                if #availableServers > 0 then
                                        local randomServer = availableServers[math.random(1, #availableServers)]
                                        TeleportService:TeleportToPlaceInstance(placeId, randomServer.id, localPlayer)
                                        return
                                end
                        end

                        TeleportService:Teleport(placeId, localPlayer)
                end)
        end

        local function auto_rejoin_queue()
                local executeCommand = tostring(Library._config._flags["Auto_Execute_Command"] or ""):match("^%s*(.-)%s*$")

                if executeCommand == "" then
                        return false
                end

                local queueFunction = queue_on_teleport or queueonteleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)

                if not queueFunction then
                        return false
                end

                queueFunction(executeCommand)

                return true
        end

        local function auto_rejoin_arm()
                if rejoinConnection then
                        rejoinConnection:Disconnect()
                        rejoinConnection = nil
                end

                rejoinTriggered = false

                local coreGui = cloneref(game:GetService("CoreGui"))
                local promptGui = coreGui:WaitForChild("RobloxPromptGui", 10)

                promptGui = promptGui and promptGui:WaitForChild("promptOverlay", 10)

                if not promptGui then
                        return
                end

                rejoinConnection = promptGui.ChildAdded:Connect(function(prompt)
                        if prompt.Name ~= "ErrorPrompt" or rejoinTriggered then
                                return
                        end

                        if game:GetService("GuiService").MenuIsOpen then
                                return
                        end

                        local messageArea = prompt:WaitForChild("MessageArea", 1)

                        if not messageArea or not messageArea:WaitForChild("ErrorFrame", 1) then
                                return
                        end

                        rejoinTriggered = true
                        auto_rejoin_queue()

                        Library.SendNotification({ title = "Auto Rejoin", text = "Rejoining...", duration = 2 })

                        task.wait(0.3)

                        TeleportService:Teleport(game.PlaceId, localPlayer)
                end)
        end

        local serverToolsModule = Misc:create_module({
                title = "Server Tools",
                flag = "Server_Tools",
                description = "Rejoin, hop or auto-rejoin after kicks",
                section = "left",
                callback = function() end,
        })

        serverToolsModule:create_feature({
                no_image = true,
                title = "Rejoin",
                button_callback = rejoin_server,
        })

        serverToolsModule:create_feature({
                no_image = true,
                title = "Server Hop",
                button_callback = hop_server,
        })

        serverToolsModule:create_divider({
                showtopic = true,
                title = "Auto Rejoin",
        })

        serverToolsModule:create_checkbox({
                title = "Auto Rejoin",
                flag = "Auto_Rejoin",
                callback = function(state)
                        if rejoinConnection then
                                rejoinConnection:Disconnect()
                                rejoinConnection = nil
                        end

                        rejoinTriggered = false

                        if state then
                                auto_rejoin_arm()
                        end
                end,
        })

        serverToolsModule:create_textbox({
                title = "Execute Command",
                placeholder = 'loadstring(game:HttpGet("url"))()',
                flag = "Auto_Execute_Command",
                callback = function() end,
        })

        serverToolsModule._size = serverToolsModule._size + 6
end

do
        local antiLagLighting = game:GetService("Lighting")
        local antiLagSoundService = game:GetService("SoundService")
        local antiLagTypes = {
                ParticleEmitter = true,
                Trail = true,
                Smoke = true,
                Fire = true,
                Sparkles = true,
                Sound = true,
        }
        local originalShadows = antiLagLighting.GlobalShadows
        local originalReverb = antiLagSoundService.AmbientReverb

        local function disable_effect(object)
                if not antiLagTypes[object.ClassName] then
                        return
                end

                pcall(function()
                        if object:IsA("Sound") then
                                if object:GetAttribute("KazeOriginalVolume") == nil then
                                        object:SetAttribute("KazeOriginalVolume", object.Volume)
                                end

                                object.Volume = 0
                                return
                        end

                        object.Enabled = false
                end)
        end

        local function disable_all_effects()
                for _, object in ipairs(workspace:GetDescendants()) do
                        disable_effect(object)
                end
        end

        local function enable_anti_lag()
                pcall(function()
                        local clientFX = localPlayer.PlayerScripts:FindFirstChild("EffectScripts")

                        clientFX = clientFX and clientFX:FindFirstChild("ClientFX")

                        if clientFX then
                                clientFX.Disabled = true
                        end
                end)

                if runtime then
                        moduleConnections["Anti Lag Runtime"] = runtime.ChildAdded:Connect(function(child)
                                Debris:AddItem(child, 0)
                        end)
                end

                moduleConnections["Anti Lag Effects"] = workspace.DescendantAdded:Connect(function(object)
                        disable_effect(object)
                end)

                moduleConnections["Anti Lag Respawn"] = localPlayer.CharacterAdded:Connect(function()
                        task.defer(disable_all_effects)
                end)

                disable_all_effects()

                pcall(function()
                        for _, object in ipairs(antiLagLighting:GetChildren()) do
                                if object:IsA("BloomEffect") or object:IsA("SunRaysEffect") or object:IsA("DepthOfFieldEffect") or object:IsA("BlurEffect") then
                                        object.Enabled = false
                                end
                        end

                        originalShadows = antiLagLighting.GlobalShadows
                        antiLagLighting.GlobalShadows = false
                end)

                pcall(function()
                        originalReverb = antiLagSoundService.AmbientReverb
                        antiLagSoundService.AmbientReverb = Enum.ReverbType.NoReverb
                end)

                Library.SendNotification({ title = "Anti Lag", text = "ON", duration = 2 })
        end

        local function disable_anti_lag()
                pcall(function()
                        local clientFX = localPlayer.PlayerScripts:FindFirstChild("EffectScripts")

                        clientFX = clientFX and clientFX:FindFirstChild("ClientFX")

                        if clientFX then
                                clientFX.Disabled = false
                        end
                end)

                for _, connectionName in ipairs({ "Anti Lag Runtime", "Anti Lag Effects", "Anti Lag Respawn" }) do
                        if moduleConnections[connectionName] then
                                moduleConnections[connectionName]:Disconnect()
                                moduleConnections[connectionName] = nil
                        end
                end

                pcall(function()
                        for _, object in ipairs(antiLagLighting:GetChildren()) do
                                if object:IsA("BloomEffect") or object:IsA("SunRaysEffect") or object:IsA("DepthOfFieldEffect") or object:IsA("BlurEffect") then
                                        object.Enabled = true
                                end
                        end

                        antiLagLighting.GlobalShadows = originalShadows
                end)

                pcall(function()
                        antiLagSoundService.AmbientReverb = originalReverb

                        for _, object in ipairs(workspace:GetDescendants()) do
                                if object:IsA("Sound") then
                                        local volume = object:GetAttribute("KazeOriginalVolume")

                                        if volume ~= nil then
                                                object.Volume = volume
                                        end
                                end
                        end
                end)

                Library.SendNotification({ title = "Anti Lag", text = "OFF", duration = 2 })
        end

        Misc:create_module({
                title = "Anti Lag",
                flag = "Anti_Lag",
                description = "Disables effects to reduce lag",
                section = "right",
                callback = function(state)
                        if state then
                                enable_anti_lag()
                                return
                        end

                        disable_anti_lag()
                end,
        })
end

