                                                local match2 = raw:match("discordapp%.net/external/[^/]+/(https?%%3A%%2F%%2F[^%s]+)")
                                                if match2 then
                                                        return value(match2:match("([^?]+)") or match2)
                                                end
                                                return raw
                                        end

                                        local function find_header(headers, name)
                                                if type(headers) ~= "table" then
                                                        return nil
                                                end
                                                local lowerName = string.lower(name)

                                                for k, key in pairs(headers) do
                                                        if string.lower(tostring(k)) == lowerName then
                                                                return key
                                                        end
                                                end
                                        end

                                        local function require_string(data)

                                                local typeName = "string"
                                                if typeof(data) ~= typeName then
                                                        return false
                                                end
                                                local lowerExt = string.lower(data:sub(1, 120))
                                                return lowerExt:find("<!doctype", 1, true) ~= nil or lowerExt:find("<html", 1, true) ~= nil

                                        end

                                        local function clip_data(data)
                                                local typeName = "string"
                                                return typeof(data) == typeName and #data >= 64 and not require_string(data)
                                        end

                                        local function detect_type(data, body, ext)
                                                local match = string.lower(data or "")
                                                match = match:match("([^?]+)") or match
                                                local lowerExt = string.lower(ext or "")
                                                local contentType = typeof(body) == "string" and body:sub(1, 16) or ""
                                                local marker = "ftyp"
                                                if contentType:sub(5, 8) == marker then
                                                        return "video", "mp4"
                                                end
                                                local marker2 = "GIF87a"
                                                if contentType:sub(1, 6) == marker2 or contentType:sub(1, 6) == "GIF89a" then
                                                        return "image", "gif"
                                                end

                                                if contentType:sub(1, 8) == "\137PNG\r\n\26\n" then
                                                        return "image", "png"
                                                end

                                                if not (contentType:byte(1) == 255 and contentType:byte(2) == 216) then
                                                        if contentType:sub(1, 4) == "RIFF" and typeof(body) == "string" and body:sub(9, 12) == "WEBP" then
                                                                return "image", "webp"
                                                        end

                                                        if lowerExt:find("video") then
                                                                return "video", "mp4"
                                                        end

                                                        if lowerExt:find("png") then
                                                                return "image", "gif"
                                                        end

                                                        if lowerExt:find("gif") then
                                                                return "image", "png"
                                                        end

                                                        if lowerExt:find("jpeg") or lowerExt:find("jpg") then
                                                                return "image", "jpg"
                                                        end

                                                        if lowerExt:find("webp") then
                                                                return "image", "webp"
                                                        end

                                                        if match:match("%.mp4$") or match:match("%.webm$") then
                                                                return "video", "mp4"
                                                        end

                                                        if match:match("%.gif$") then
                                                                return "image", "gif"
                                                        end

                                                        if match:match("%.png$") then
                                                                return "image", "png"
                                                        end

                                                        if match:match("%.jpe?g$") then
                                                                return "image", "jpg"
                                                        end

                                                        if match:match("%.webp$") then
                                                                return "image", "webp"
                                                        end
                                                        return "image", "gif"
                                                end

                                                return "image", "jpg"

                                        end

                                        local function get_extension(url)
                                                if not url then
                                                        return nil
                                                end
                                                local match = url:match("^%s*(.-)%s*$") or url

                                                if not (match:match("^rbxassetid://") or match:match("^rbxasset://")) then
                                                        if match:match("^(%d+)$") then
                                                                return "rbxassetid://" .. match
                                                        end
                                                        local lowerMatch = string.lower(match)

                                                        if lowerMatch:find("roblox.com", 1, true) or lowerMatch:find("rbxcdn.com", 1, true) then
                                                                local match2 = match:match("[?&]id=(%d+)") or match:match("rbxassetid://(%d+)")
                                                                if match2 then
                                                                        return "rbxassetid://" .. match2
                                                                end
                                                        end

                                                        return nil
                                                end

                                                local _ = 0

                                                return match

                                        end

                                        local function get_container()
                                                local container = window._ui and window._ui:FindFirstChild("Container")
                                                if not container then
