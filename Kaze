                                        local function update_background(visible)
                                                get_container()
                                                set_blur(n)

                                                if visible == "video" then
                                                        if imageLabel then
                                                                imageLabel.Visible = false
                                                                imageLabel.Image = ""
                                                        end

                                                        if videoFrame then
                                                                videoFrame.Visible = true
                                                                stop_video()
                                                        end

                                                        if result then
                                                                result.Visible = n > 0
                                                        end
                                                else
                                                        if videoFrame then
                                                                pcall(function()
                                                                        videoFrame:Pause()
                                                                end)

                                                                videoFrame.Visible = false
                                                                videoFrame.Video = ""
                                                        end

                                                        if imageLabel then
                                                                imageLabel.Visible = true
                                                        end

                                                        if result then
                                                                result.Visible = false
                                                        end
                                                end
                                        end

                                        local function build_url(base, path)
                                                if type(path) ~= "string" or path == "" then
                                                        return nil
                                                end

                                                if path:match("^https?://") then
                                                        return path
                                                end
                                                local match = base:match("^(https?://[^/]+)")
                                                if not match then
                                                        return nil
                                                end

                                                if path:sub(1, 1) == "/" then
                                                        return match .. path
                                                end
                                                return (base:match("^(https?://.+)/") or match) .. "/" .. path
                                        end

                                        local resolve_redirects = nil

                                        resolve_redirects = function(url, depth)
                                                local depth2 = depth or 0
                                                if depth2 > 6 then
                                                        return nil, nil
                                                end
                                                local request = get_request()
                                                local body = nil
                                                local response = nil

                                                if request then
                                                        local ok, result = pcall(request, {
                                                                Url = url,
                                                                Method = "GET",
                                                                Headers = {
                                                                        ["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36",
                                                                        Accept = "*/*",
                                                                        ["Accept-Language"] = "en-US,en;q=0.9",
                                                                        ["Referer"] = "https://discord.com/",
                                                                },
                                                        })

                                                        local succeeded

                                                        if ok then
                                                                local typeName = "table"
                                                                succeeded = type(result) == typeName
                                                        else
                                                                succeeded = ok
                                                        end

                                                        body = nil
                                                        response = nil

                                                        if succeeded then
                                                                local num = tonumber(result.StatusCode or result.Status)
                                                                local headers = result.Headers
                                                                response = find_header(headers, "Content-Type")

                                                                if num and num >= 300 and num < 400 then
                                                                        local fullUrl = build_url(url, find_header(headers, "Location"))
                                                                        body = nil
                                                                        if fullUrl then
                                                                                return resolve_redirects(fullUrl, depth2 + 1)
                                                                        end
                                                                else
                                                                        local isSuccess = num == 200 or num == 201 or num == 206
                                                                        body = nil

                                                                        if isSuccess then
                                                                                body = result.Body
                                                                        end
                                                                end
                                                        end
                                                end

                                                if not clip_data(body) then
                                                        local ok, result = pcall(function()
                                                                return game:HttpGet(url)
                                                        end)

                                                        if ok then
                                                                body = result
                                                        end
                                                end

                                                if not clip_data(body) then
                                                        return nil, response
                                                end
                                                return body, response
                                        end

                                        local function resolve_urls(urls)
                                                for _, url in ipairs(urls) do
                                                        local data, contentType = resolve_redirects(url)
                                                        if clip_data(data) then
                                                                return data, contentType, url
                                                        end
                                                end
                                        end

                                        local function get_media_label(mediaType, url)
                                                local target = mediaType == "video" and videoFrame or imageLabel
                                                if not target then
                                                        return false
                                                end
                                                local now2 = os.clock()

                                                while true do
                                                        local parent = target.Parent

                                                        if parent then
                                                                parent = os.clock() - now2 < (url or 5)
                                                        end

                                                        if parent then
                                                                if target.IsLoaded == true then
                                                                        return true
                                                                end
                                                                task.wait()
                                                                continue
                                                        end

                                                        break
                                                end

                                                return target.IsLoaded == true
                                        end

                                        local function save_asset(data, ext)
                                                downloadCount += 1
                                                local match = data:match("%.([%w]+)$") or "png"
                                                local assetName = ""
                                                local assetPath = "winds_bg_" .. tostring(os.time()) .. assetName .. tostring(downloadCount) .. "." .. match
                                                writefile(assetPath, ext)
                                                task.wait(0.15)
                                                local genv = getgenv and getgenv() or {}
                                                local getcustomasset_ = genv.getcustomasset or getcustomasset or genv.getsynasset or getsynasset
                                                if type(getcustomasset_) ~= "function" then
                                                        return nil
                                                end
                                                local ok, result = pcall(getcustomasset_, assetPath, true)
                                                if ok and typeof(result) == "string" and result ~= "" then
                                                        return result
                                                end
                                                local ok2, result2 = pcall(getcustomasset_, assetPath)

                                                if ok2 then
                                                        local typeName = "string"
                                                        ok2 = typeof(result2) == typeName
                                                end

                                                if ok2 and result2 ~= "" then
                                                        return result2
                                                end
                                                return nil
                                        end

                                        local function cleanup_assets(keep, assets)
                                                get_container()

                                                for _, asset in ipairs(assets) do
                                                        if type(asset) == "string" and asset ~= "" then
                                                                local ok

                                                                if keep == "video" then
                                                                        ok = pcall(function()
                                                                                videoFrame.Video = asset
                                                                                videoFrame.Looped = true
                                                                                videoFrame.Volume = 0
                                                                                videoFrame:Play()
                                                                        end)
                                                                else
                                                                        ok = pcall(function()
                                                                                imageLabel.Image = asset
                                                                        end)
                                                                end

                                                                if ok then
                                                                        update_background(keep)

                                                                        if keep ~= "video" then
                                                                                if imageLabel then
                                                                                        imageLabel.Image = ""
                                                                                        imageLabel.Image = asset
                                                                                end

                                                                                return true
                                                                        end

                                                                        if get_media_label(keep, keep == "video" and 2.5 or asset:match("^https?://") and 2 or 4) then
                                                                                if keep == "video" then
                                                                                        stop_video()
                                                                                end

                                                                                return true
                                                                        end
                                                                end
                                                        end
                                                end

                                                return false
                                        end

                                        local function load_background(url, saveHistory)
                                                taskId += 1
                                                local taskId = taskId

                                                task.spawn(function()
                                                        if not backgroundEnabled then
                                                                hide_image()
                                                                return
                                                        end
                                                        url = tostring(url or ""):match("^%s*(.-)%s*$") or ""
                                                        if url == "" then
                                                                hide_image()
                                                                return
                                                        end

                                                        if not get_container() then
                                                                return
                                                        end
                                                        local ext = get_extension(url)

                                                        if ext then
                                                                if taskId ~= taskId then
                                                                        return
                                                                end
                                                                local urls = { ext, url }
                                                                if cleanup_assets(detect_type(url), urls) then
                                                                        return
                                                                end
                                                        end

                                                        ensure_folder()
                                                        local resolved = resolve_discord_url(url)

                                                        if imageLabel then
                                                                imageLabel.Image = ""
                                                        end

                                                        local urls = { resolved }

                                                        if resolved ~= url then
                                                                table.insert(urls, url)
                                                        end

                                                        local data, contentType, ext2 = resolve_urls(urls)
                                                        if taskId ~= taskId then
                                                                return
                                                        end

                                                        if not clip_data(data) then
                                                                if not saveHistory then
                                                                        Library.SendNotification({ title = "Background", text = "Failed to download URL", duration = 5 })
                                                                end

                                                                return
                                                        end

                                                        local mediaType, extension = detect_type(ext2 or resolved, data, contentType)
                                                        pcall(writefile, "Winds/Background/source.txt", url)
                                                        pcall(writefile, "Winds/Background/kind.txt", mediaType .. "|" .. extension)
                                                        if taskId ~= taskId then
                                                                return
                                                        end
                                                        local label

                                                        if mediaType then
                                                                label = mediaType
                                                        else
                                                                label = detect_type(ext2 or resolved, data, contentType)
                                                        end

                                                        if label == "video" then
                                                                local mp4 = save_asset("clip.mp4", data)

                                                                if mp4 then
                                                                        get_container()

                                                                        pcall(function()
                                                                                videoFrame.Video = ""
                                                                                videoFrame.Video = mp4
                                                                                videoFrame.Looped = true
                                                                                videoFrame.Volume = 0
                                                                                videoFrame:Play()
                                                                        end)

                                                                        update_background("video")
                                                                        if get_media_label("video", 5) then
                                                                                stop_video()
                                                                                return
                                                                        end

                                                                        pcall(function()
                                                                                videoFrame:Pause()
                                                                                videoFrame.Visible = false
                                                                                videoFrame.Video = ""
                                                                        end)
                                                                end

                                                                if not saveHistory then
                                                                        Library.SendNotification({
                                                                                title = "Background",
                                                                                text = "This MP4 can't play. Use PNG or JPG.",
                                                                                duration = 5,
                                                                        })
                                                                end

                                                                return
                                                        end

                                                        local assetPath = save_asset("winds_bg." .. (extension or "png"), data)
                                                        if cleanup_assets("image", { assetPath }) then
                                                                return
                                                        end

                                                        if not saveHistory then
                                                                Library.SendNotification({ title = "Background", text = "Couldn't load this file on your executor", duration = 3 })
                                                        end
                                                end)
                                        end

                                        local backgroundModule = Optimization:create_module({
