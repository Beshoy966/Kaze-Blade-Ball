elevated = function(fn)
        local identity = 8

        if typeof(getthreadidentity) == "function" then
                pcall(function()
                        identity = getthreadidentity()
                end)
        end

        if identity ~= 8 and typeof(setthreadidentity) == "function" then
                pcall(setthreadidentity, 8)
                local ok, err = pcall(fn)
                pcall(setthreadidentity, identity < 8 and 8 or identity)
                return ok, err
        end

        return pcall(fn)
end

