                                local function hex_to_color(hex)
                                        if typeof(hex) ~= "string" then
                                                return nil
                                        end

                                        hex = hex:gsub("#", ""):lower():gsub("[^%x]", "")

                                        if #hex == 3 then
                                                hex = hex:sub(1, 1):rep(2) .. hex:sub(2, 2):rep(2) .. hex:sub(3, 3):rep(2)
                                        end

                                        if #hex ~= 6 then
                                                return nil
                                        end

                                        local r = tonumber(hex:sub(1, 2), 16)
                                        local g = tonumber(hex:sub(3, 4), 16)
                                        local b = tonumber(hex:sub(5, 6), 16)

                                        if not r or not g or not b then
                                                return nil
                                        end

                                        return Color3.fromRGB(r, g, b)
                                end

                                local function color_to_hex(color)
                                        return string.format("%02X%02X%02X", math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5))
                                end

                                local function color_key(color)
                                        return math.floor(color.R * 255 + 0.5) * 65536 + math.floor(color.G * 255 + 0.5) * 256 + math.floor(color.B * 255 + 0.5)
                                end

                                local function shift_color(color, delta)
                                        return Color3.new(
                                                math.clamp(color.R + delta / 255, 0, 1),
                                                math.clamp(color.G + delta / 255, 0, 1),
                                                math.clamp(color.B + delta / 255, 0, 1)
                                        )
                                end

                                local function get_theme_color(themeKey)
                                        if themeKey == "accent" then
                                                return getgenv().KAZE_ACCENT or Theme.white
                                        end

                                        return Theme[themeKey]
                                end

                                local function get_stored_color(themeKey)
                                        local savedHex = Library._config._flags["KazeTheme_" .. themeKey]

                                        if savedHex then
                                                local savedColor = hex_to_color(savedHex)

                                                if savedColor then
                                                        return savedColor
                                                end
                                        end

                                        return get_theme_color(themeKey)
                                end

                                local function is_guarded(inst)
                                        local node = inst

                                        while node do
                                                if node:GetAttribute("KazeGuard") then
                                                        return true
                                                end

                                                node = node.Parent
                                        end

                                        return false
                                end

                                local function bucket_add(themeKey, inst, prop)
                                        if not themeKey then
                                                return
                                        end

                                        local bucket = boundBuckets[themeKey]

                                        if not bucket then
                                                bucket = {}
                                                boundBuckets[themeKey] = bucket
                                        end

                                        table.insert(bucket, { inst = inst, prop = prop })
                                end

                                local function recolor_key(themeKey, color)
                                        local bucket = boundBuckets[themeKey]

                                        if bucket then
                                                for _, entry in ipairs(bucket) do
                                                        entry.inst[entry.prop] = color
                                                end
                                        end

                                        for _, entry in ipairs(boundGradients) do
                                                local keypoints = entry.inst.Color.Keypoints
                                                local touched = false
                                                local rebuilt = {}

                                                for index, keypoint in ipairs(keypoints) do
                                                        local pointColor = keypoint.Value
                                                        local pointKey = entry.keys[index]

                                                        if pointKey == themeKey then
                                                                pointColor = color
                                                                touched = true
                                                        end

                                                        rebuilt[index] = ColorSequenceKeypoint.new(keypoint.Time, pointColor)
                                                end

                                                if touched then
                                                        entry.inst.Color = ColorSequence.new(rebuilt)
                                                end
                                        end
                                end

