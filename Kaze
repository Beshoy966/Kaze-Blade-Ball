                                end

                                local connectionFunction = connection.Function

                                if not connectionFunction or getfenv(connectionFunction).script ~= controller then
                                        return false
                                end

                                rewardsPending[button] = { check = check, names = names }
                                connection:Fire()

                                return true
                        end)

                        if okAttempt and attempted then
                                return true
                        end
                end

                return false
        end

