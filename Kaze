                                                value [name]:Disconnect()
                                        end)
                                        value [name] = nil
                                end,
                                disconnect_all = function(value)
                                        for _, value in pairs(value) do
                                                local typeName = "function"

                                                if typeof(value) ~= typeName then
                                                        pcall(function()
                                                                value:Disconnect()
                                                        end)
                                                end
                                        end
                                end,
                        }

                        do
                                local Util = setmetatable({
                                        map = function(value, value2, minValue, maxValue, outMin, outMax)
                                                return (value2 - minValue) * (outMax - outMin) / (maxValue - minValue) + outMin
                                        end,
                                        viewport_point_to_world = function(value, point, depth)
                                                local ray = workspace.CurrentCamera:ScreenPointToRay(point.X, point.Y)
                                                return ray.Origin + ray.Direction * depth
                                        end,
                                        get_offset = function(value)
                                                return value:map(workspace.CurrentCamera.ViewportSize.Y, 0, 1080, 8, 56)
                                        end,
                                }, Util)

                                Acrylic = {}
                                Acrylic.__index = Acrylic

                                Acrylic.new = function(object)
                                        -- [KAZE FIX] The acrylic effect is OFF by default: it spawns a full-screen
                                        -- DepthOfFieldEffect + a glass Part that is re-rendered every RenderStepped,
                                        -- which is extremely GPU heavy and was freezing the game on startup.
                                        -- Set getgenv().KAZE_ACRYLIC = true BEFORE running to re-enable it.
                                        if getgenv().KAZE_ACRYLIC ~= true then
                                                return setmetatable({}, {
