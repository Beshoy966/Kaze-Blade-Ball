Library.bump_score = function(name, amount)
        local score = Library._scores [name]

        if not score then
                return
        end

        elevated(function()
                score.count = score.count + (amount or 1)
                score.countLabel.Text = tostring(score.count)

                if tick() - score.lastPulse >= 0.18 then
                        score.lastPulse = tick()
                        score.dot.BackgroundTransparency = 0
                        TweenService:Create(score.dot, TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { BackgroundTransparency = 0.35 }):Play()
                        TweenService:Create(score.countLabel, TweenInfo.new(0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { TextColor3 = accent() }):Play()

                        task.delay(0.2, function()
                                if score.countLabel.Parent then
                                        TweenService:Create(score.countLabel, TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { TextColor3 = Theme.text }):Play()
                                end
                        end)
                end
        end)
end

Library.hide_score = function(name)
        local score = Library._scores [name]

        if not score then
                return
        end

        Library._scores [name] = nil
        TweenService:Create(score.chip, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.In), { Position = UDim2.new(1.5, 0, 0, 0) }):Play()

        task.delay(0.36, function()
                score.holder:Destroy()
        end)
end

