        self._ui.AncestryChanged:Once(callback)
end

Library.flag_type = function(self, flag, expectedType)
        if not Library._config._flags [flag] then
                return
        end

        return typeof(Library._config._flags [flag]) == expectedType
end

Library.remove_table_value = function(self, list, value)
        -- [KAZE FIX] the old loop shadowed `value` (`for k, value in pairs(list)`),
        -- so the check `value == value` was always true and wrong entries were removed.
        for k, item in pairs(list) do
                if item == value then
                        table.remove(list, k)
                        break
                end
        end
end

