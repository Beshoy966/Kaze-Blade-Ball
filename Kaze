                                end

                                data.update_positions = function(self, value)
                                        local value2 = (self.max_value - config.minimum_value) / (config.maximum_value - config.minimum_value)
                                        local minPercent = math.clamp((self.min_value - config.minimum_value) / (config.maximum_value - config.minimum_value), 0, 1)
                                        local maxPercent = math.clamp(value2, 0, 1)

                                        if value then
                                                TweenService:Create(self.min_thumb,
                                                TweenInfo.new(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
                                                { Position = UDim2.new(minPercent, (0.5 - minPercent) * 10, 0.5, 0) }):Play()
                                                TweenService:Create(self.max_thumb,
                                                TweenInfo.new(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
                                                { Position = UDim2.new(maxPercent, (0.5 - maxPercent) * 10, 0.5, 0) }):Play()
                                                TweenService:Create(self.fill,
                                                TweenInfo.new(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
                                                { Size = UDim2.new(maxPercent - minPercent, 0, 1, 0), Position = UDim2.new(minPercent, 0, 0.5, 0) }):Play()
                                        else
                                                self.min_thumb.Position = UDim2.new(minPercent, (0.5 - minPercent) * 10, 0.5, 0)
                                                self.max_thumb.Position = UDim2.new(maxPercent, (0.5 - maxPercent) * 10, 0.5, 0)
                                                self.fill.Size = UDim2.new(maxPercent - minPercent, 0, 1, 0)
                                                self.fill.Position = UDim2.new(minPercent, 0, 0.5, 0)

                                        end

                                        if config.round_number then
                                                textLabel8.Text = string.format("%.0f, %.0f", self.min_value, self.max_value)
                                        else
                                                textLabel8.Text = string.format("%.1f, %.1f", self.min_value, self.max_value)
