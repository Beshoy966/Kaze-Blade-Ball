                                                        local shared = ReplicatedStorage:FindFirstChild("Shared")
                                                        local replicated = shared and shared:FindFirstChild("ReplicatedInstances")
                                                        local swordsFolder = replicated and replicated:FindFirstChild("Swords")

                                                        if swordsFolder and swordsFolder:FindFirstChild(itemName) then
