        end

        local function input_ended(input)
                return input.UserInputState == Enum.UserInputState.End or input.UserInputState == Enum.UserInputState.Cancel
        end

        local function end_drag()
                if not dragInput then
                        return
                end
                stop_drag()
                self._dragging = false
        end

        local function start_drag(input)
                stop_drag()
                dragInput = input
                isTouch = input.UserInputType == Enum.UserInputType.Touch
                vector2 = Vector2.new(input.Position.X, input.Position.Y)
                position = frame.Position
                self._dragging = false

                connection = input.Changed:Connect(function(changed)
                        if changed == "UserInputState" and input_ended(input) then
                                end_drag()
                        end
                end)
        end

        local function update_drag(input)
                local vector22 = Vector2.new(input.Position.X - vector2.X, input.Position.Y - vector2.Y)

                if not self._dragging then
                        if vector22.Magnitude < 3 then
                                return
                        end
                        self._dragging = true
                end

                frame.Position = UDim2.new(position.X.Scale, position.X.Offset + vector22.X, position.Y.Scale, position.Y.Offset + vector22.Y)
        end

