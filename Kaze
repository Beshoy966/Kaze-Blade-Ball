                                        local function stop_video()
                                                if not videoFrame then
                                                        return
                                                end

                                                task.spawn(function()
                                                        local now2 = os.clock()

                                                        while videoFrame and videoFrame.Parent and not videoFrame.IsLoaded and os.clock() - now2 < 8 do
                                                                task.wait()
                                                        end

                                                        if videoFrame and videoFrame.Visible then
                                                                pcall(function()
                                                                        videoFrame.Looped = true
                                                                        videoFrame.Volume = 0
                                                                        videoFrame:Play()
                                                                end)
                                                        end
