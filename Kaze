                                                                local distance = localPlayer:DistanceFromCharacter(ballPosition)
                                                                local lock = Functions.Get_Ball_Lock(ball)
                                                                local now2 = tick()

                                                                if ballTarget ~= lock.lastTarget then
                                                                        lock.lastTarget = ballTarget
                                                                        lock.LolParried = false
                                                                end

                                                                if lock.LolParried then
                                                                        if now2 - lock.lastFireTick < 1 then
