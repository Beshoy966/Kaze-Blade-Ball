convertStringToTable = function(value)
        local list = {}

        for match in string.gmatch(value, "([^,]+)") do
                local match2 = match:match("^%s*(.-)%s*$")
                table.insert(list, match2)
        end

        return list
end

convertTableToString = function(list)
        return table.concat(list, ", ")
end

