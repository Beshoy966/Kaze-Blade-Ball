                                                        videoFrame.Name = "CustomBackgroundVideo"
                                                        videoFrame.BackgroundTransparency = 1
                                                        videoFrame.BorderSizePixel = 0
                                                        videoFrame.Size = UDim2.fromScale(1, 1)
                                                        videoFrame.Position = UDim2.fromScale(0, 0)
                                                        videoFrame.Looped = true
