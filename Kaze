        Functions.Is_Curved = function(f)
                if not f then
                        return false
                end
                local zoomies = f:FindFirstChild("zoomies")

                if not zoomies then
                        return false
                end
                local character = localPlayer2.Character

                if not (character and (character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart)) then
                        return false
                end
                local rootPart = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
                local velocity = zoomies.VectorVelocity
                local speed = velocity.Magnitude

                if speed < 1 then
                        return false
                end
                local ballPosition = Functions.Ball_Position(f)

                if not ballPosition then
                        return false
                end
                local delta = rootPart.Position - ballPosition
                local distance = delta.Magnitude

                if distance < 0.001 then
                        return false
                end
                local toMe = delta * (1 / distance)
                local velUnit = velocity * (1 / speed)
                local pingSec = Functions.Get_Ping_MS() / 1000
                local timeToImpact = math.max(distance / speed - pingSec, 1 / 60)
                local targeted = f:GetAttribute("target") == localPlayer.Name

                local dot = toMe:Dot(velUnit)

                if getgenv().BackWardsAntiCurve ~= false and dot < -0.65 then
                        return true
                end

                local lookahead = math.clamp(pingSec * 2.5 + (distance / speed) * 0.15, pingSec * 2.5, 0.65)
                local futurePosition = ballPosition + velocity * lookahead
                local futureDelta = rootPart.Position - futurePosition
                local futureDistance = futureDelta.Magnitude
                local futureDot = futureDistance > 0.001 and (futureDelta * (1 / futureDistance)):Dot(velUnit) or dot

                local cross = toMe:Cross(velUnit).Magnitude

                local predictedPosition = ballPosition + velocity * timeToImpact
                local missAmount = (rootPart.Position - predictedPosition).Magnitude
                local hitbox = math.clamp(3 + pingSec * speed * 0.06 + distance * 0.03, 3, 16)
                local willMiss = missAmount > hitbox

                if targeted and distance < 260 then
                        if dot < 0.12 and futureDot < 0.22 then
                                return true
                        end
                        local backwardsThreshold = math.clamp(0.65 - (distance / 260) * 0.20, 0.38, 0.65)

                        if willMiss and dot < backwardsThreshold and speed > 10 then
                                return true
                        end
                        if dot < 0 and distance < 45 and speed > 12 then
                                return true
                        end
                end

                local lock = Functions.Get_Ball_Lock(f)
                local angleRad = math.acos(math.clamp(dot, -1, 1))

                lock.Lerp_Radians = Functions.Lerp(lock.Lerp_Radians, angleRad, 0.62)

                if lock.Lerp_Radians < 0.033 then
                        lock.Last_Warping = tick()
                end

                local now2 = tick()
                local tiWindow = math.min(timeToImpact, 0.7)

                if (now2 - lock.Last_Warping) < tiWindow and (now2 - lock.Curving) < tiWindow then
                        return true
                end

                local dotThreshold = math.clamp(0.28 + pingSec * 0.35, 0.28, 0.52)
                local crossNeeded = 0.05 + (distance / 650) * 0.04

                if cross > crossNeeded and dot < dotThreshold then
                        return true
                end

                if targeted and cross > crossNeeded * 1.5 then
                        return true
                end

                return false
        end
