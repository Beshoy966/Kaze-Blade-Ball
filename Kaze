        local function strip_fflag_prefix(flag)
                return (flag:gsub("^DFInt", ""):gsub("^DFFlag", ""):gsub("FString", ""):gsub("FLog", ""):gsub("^FFlag", ""):gsub("^DFint", ""):gsub("^FInt", ""))
        end

        fflagPreset = false
        fflagString = ""
        local originalValues = {}
        local appliedFlags = {}

        local function valid_flag_name(flag)
                if getfflag then
                        local ok, result = pcall(getfflag, strip_fflag_prefix(flag))
                        if ok and result then
                                return strip_fflag_prefix(flag)
                        end
                        local ok2, result2 = pcall(getfflag, flag)
                        if ok2 and result2 then
                                return flag
                        end
                end

                return strip_fflag_prefix(flag)
        end

        apply_fflags = function(flags)
                if not setfflag then
                        warn("this executor isnt supported, for using fflags.")
                        return false
                end

                task.spawn(function()

                        local count = 0
                        appliedFlags = {}

                        for k, value in pairs(flags) do
                                local flagName = valid_flag_name(k)

                                pcall(function()
                                        if originalValues [flagName] == nil and getfflag then
                                                originalValues [flagName] = getfflag(flagName)
                                        end

                                        setfflag(flagName, value)
                                        count += 1
                                        table.insert(appliedFlags, flagName)
                                end)
                        end
                end)

                return true
        end

        restore_fflags = function()
                if not setfflag then
                        return
                end

                task.spawn(function()

                        local n = 0

                        for _, flag in ipairs(appliedFlags) do
                                local original = originalValues [flag]

                                if original ~= nil then
                                        if pcall(setfflag, flag, original) then
                                                n += 1
                                        end
                                end
                        end

                        appliedFlags = {}

                        return

                end)
        end
end

