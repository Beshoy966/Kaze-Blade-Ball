do
        local trailHue = 0
        local trailColor = Color3.new(1, 1, 1)
        local trackedBalls = setmetatable({}, { __mode = "k" })

        local function clear_ball_effects(ball)
                for _, objectName in ipairs({ "KazeTrail", "KazeEmitter", "KazeGlow", "KazeAtt0", "KazeAtt1" }) do
                        local object = ball:FindFirstChild(objectName)

                        if object then
                                object:Destroy()
                        end
                end

                trackedBalls [ball] = nil
        end

        local function apply_ball_effects(ball)
                if not getgenv().BallTrailEnabled then
                        if trackedBalls [ball] then
                                clear_ball_effects(ball)
                        end

                        return
                end

                if trackedBalls [ball] then
                        local trail = ball:FindFirstChild("KazeTrail")

                        if trail then
                                if getgenv().BallTrailRainbowEnabled then
                                        local color = Color3.fromHSV(trailHue / 360, 1, 1)
                                        trail.Color = ColorSequence.new(color)
                                        trailColor = color
                                else
                                        trail.Color = ColorSequence.new(trailColor)
                                end
                        end

                        return
                end

                trackedBalls [ball] = true

                local att0 = Instance.new("Attachment")
                att0.Name = "KazeAtt0"
                att0.Position = Vector3.new(0, ball.Size.Y / 2, 0)
                att0.Parent = ball

                local att1 = Instance.new("Attachment")
                att1.Name = "KazeAtt1"
                att1.Position = Vector3.new(0, -ball.Size.Y / 2, 0)
                att1.Parent = ball

                local trail = Instance.new("Trail")
                trail.Name = "KazeTrail"
                trail.Attachment0 = att0
                trail.Attachment1 = att1
                trail.Lifetime = 0.4
                trail.WidthScale = NumberSequence.new(0.5)
                trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
                trail.Color = ColorSequence.new(trailColor)
                trail.Parent = ball

                if getgenv().BallTrailParticleEnabled then
                        local emitter = Instance.new("ParticleEmitter")
                        emitter.Name = "KazeEmitter"
                        emitter.Rate = 100
                        emitter.Lifetime = NumberRange.new(0.5, 1)
                        emitter.Speed = NumberRange.new(0, 1)
                        emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
                        emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
                        emitter.Color = ColorSequence.new(trailColor)
                        emitter.Parent = ball
                end

                if getgenv().BallTrailGlowEnabled then
                        local glow = Instance.new("PointLight")
                        glow.Name = "KazeGlow"
                        glow.Range = 15
                        glow.Brightness = 2
                        glow.Color = trailColor
                        glow.Parent = ball
                end
        end

        moduleConnections ["Ball Trail Hue"] = RunService.Heartbeat:Connect(function()
                trailHue = (trailHue + 1) % 360

                for _, ball in Functions.Get_Balls() do
                        if ball:IsA("BasePart") then
                                apply_ball_effects(ball)
                        end
                end
        end)

        local ballTrailModule = VisualsTab:create_module({
                title = "Ball Trail",
                flag = "Ball_Trail",
                description = "Adds a custom trail to the ball",
                section = "left",
                callback = function(state)
                        getgenv().BallTrailEnabled = state == true

                        if not state then
                                for ball in pairs(trackedBalls) do
                                        if ball.Parent then
